#!/usr/bin/env bash
set -e

HERE="$(dirname "$(readlink -f "${0}")")"
export PATH="$HERE/usr/bin:$PATH"
export APP_DIR="$HERE/opt/nuvem-linux"
export NODE_PATH="$HERE/opt/nuvem-linux/node_modules"

APP_URL="http://127.0.0.1:4173"

is_running() {
  curl -s -m 1 "$APP_URL/api/status" >/dev/null 2>&1
}

# Inicia o servidor em segundo plano caso ainda não esteja rodando
if ! is_running; then
  NODE_EXEC="$HERE/usr/bin/node"
  if [ ! -x "$NODE_EXEC" ]; then
    NODE_EXEC="$(command -v node 2>/dev/null || echo "node")"
  fi
  nohup "$NODE_EXEC" "$HERE/opt/nuvem-linux/server.js" >/dev/null 2>&1 &
  for _ in {1..25}; do
    if is_running; then break; fi
    sleep 0.2
  done
fi

open_window() {
  if command -v google-chrome >/dev/null 2>&1; then
    exec google-chrome --app="$APP_URL" --class="nuvem-linux" >/dev/null 2>&1
  elif command -v google-chrome-stable >/dev/null 2>&1; then
    exec google-chrome-stable --app="$APP_URL" --class="nuvem-linux" >/dev/null 2>&1
  elif command -v chromium >/dev/null 2>&1; then
    exec chromium --app="$APP_URL" --class="nuvem-linux" >/dev/null 2>&1
  elif command -v chromium-browser >/dev/null 2>&1; then
    exec chromium-browser --app="$APP_URL" --class="nuvem-linux" >/dev/null 2>&1
  elif command -v brave-browser >/dev/null 2>&1; then
    exec brave-browser --app="$APP_URL" --class="nuvem-linux" >/dev/null 2>&1
  elif command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$APP_URL" >/dev/null 2>&1
  else
    printf "Nuvem Linux pronto em: %s\n" "$APP_URL"
  fi
}

case "${1:-open}" in
  open|"")
    open_window
    ;;
  status)
    if is_running; then
      echo "Nuvem Linux está ATIVO e respondendo em $APP_URL"
    else
      echo "Nuvem Linux está PARADO."
    fi
    ;;
  stop)
    pkill -f "nuvem-linux.*server.js" 2>/dev/null || true
    echo "Nuvem Linux encerrado."
    ;;
  server)
    # Executa em primeiro plano (ideal para depuração ou containers)
    exec "$HERE/usr/bin/node" "$HERE/opt/nuvem-linux/server.js"
    ;;
  *)
    exec "$HERE/packaging/bin/nuvem-linux" "$@" 2>/dev/null || open_window
    ;;
esac

